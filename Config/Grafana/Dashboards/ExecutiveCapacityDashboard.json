{
  "title": "Executive Capacity Dashboard",
  "tags": ["capacity", "executive"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Overall Capacity State",
      "type": "stat",
      "datasource": {"type": "postgres", "uid": "CapacityPostgreSQL"},
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 0},
      "targets": [{"refId": "A", "format": "table", "rawSql": "select OverallRisk from RiskAssessment order by CalculatedAt desc limit 1"}]
    },
    {
      "id": 2,
      "title": "Services With Saturation Risk",
      "type": "table",
      "datasource": {"type": "postgres", "uid": "CapacityPostgreSQL"},
      "gridPos": {"h": 9, "w": 12, "x": 6, "y": 0},
      "targets": [{"refId": "A", "format": "table", "rawSql": "select ScopeId, OverallRisk, Reason, CalculatedAt from RiskAssessment where OverallRisk in ('Warning','Critical') order by CalculatedAt desc limit 20"}]
    },
    {
      "id": 3,
      "title": "Capacity Used Vs Available",
      "type": "table",
      "datasource": {"type": "postgres", "uid": "CapacityPostgreSQL"},
      "gridPos": {"h": 9, "w": 6, "x": 18, "y": 0},
      "targets": [{"refId": "A", "format": "table", "rawSql": "select ResourceId, AverageUtilization as UsedPercent, HeadroomAvailable as AvailablePercent from CapacityKpi order by CalculatedAt desc limit 20"}]
    },
    {
      "id": 4,
      "title": "Forecast 30/60/90 Days",
      "type": "table",
      "datasource": {"type": "postgres", "uid": "CapacityPostgreSQL"},
      "gridPos": {"h": 9, "w": 14, "x": 0, "y": 9},
      "targets": [{"refId": "A", "format": "table", "rawSql": "select ResourceId, Forecast30Days, Forecast60Days, Forecast90Days, DaysToSaturation from ForecastResult order by CalculatedAt desc limit 30"}]
    },
    {
      "id": 5,
      "title": "Recommendations",
      "type": "table",
      "datasource": {"type": "postgres", "uid": "CapacityPostgreSQL"},
      "gridPos": {"h": 9, "w": 10, "x": 14, "y": 9},
      "targets": [{"refId": "A", "format": "table", "rawSql": "select Priority, Action, Reason, Status from Recommendation where Status = 'Open' order by Priority desc limit 30"}]
    }
  ]
}
