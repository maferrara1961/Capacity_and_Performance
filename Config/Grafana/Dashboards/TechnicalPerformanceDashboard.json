{
  "title": "Technical Performance Dashboard",
  "tags": ["capacity", "technical"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "CPU",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "VictoriaMetrics"},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0},
      "targets": [{"refId": "A", "expr": "synthetic_cpu", "legendFormat": "{{resource_id}} {{load_id}}"}]
    },
    {
      "id": 2,
      "title": "RAM",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "VictoriaMetrics"},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 0},
      "targets": [{"refId": "A", "expr": "synthetic_ram", "legendFormat": "{{resource_id}} {{load_id}}"}]
    },
    {
      "id": 3,
      "title": "Storage",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "VictoriaMetrics"},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0},
      "targets": [{"refId": "A", "expr": "synthetic_storage", "legendFormat": "{{resource_id}} {{load_id}}"}]
    },
    {
      "id": 4,
      "title": "Network IOPS Latency Throughput Errors",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "VictoriaMetrics"},
      "gridPos": {"h": 9, "w": 14, "x": 0, "y": 8},
      "targets": [
        {"refId": "A", "expr": "synthetic_network", "legendFormat": "network {{resource_id}}"},
        {"refId": "B", "expr": "synthetic_iops", "legendFormat": "iops {{resource_id}}"},
        {"refId": "C", "expr": "synthetic_latency", "legendFormat": "latency {{resource_id}}"},
        {"refId": "D", "expr": "synthetic_throughput", "legendFormat": "throughput {{resource_id}}"},
        {"refId": "E", "expr": "synthetic_errors", "legendFormat": "errors {{resource_id}}"}
      ]
    },
    {
      "id": 5,
      "title": "Average Peak P95",
      "type": "table",
      "datasource": {"type": "postgres", "uid": "CapacityPostgreSQL"},
      "gridPos": {"h": 9, "w": 10, "x": 14, "y": 8},
      "targets": [{"refId": "A", "format": "table", "rawSql": "select ResourceId, MetricName, AverageUtilization, PeakUtilization, P95Utilization from CapacityKpi order by CalculatedAt desc limit 50"}]
    },
    {
      "id": 6,
      "title": "Threshold Breaches",
      "type": "table",
      "datasource": {"type": "postgres", "uid": "CapacityPostgreSQL"},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 17},
      "targets": [{"refId": "A", "format": "table", "rawSql": "select ScopeId, OverallRisk, Reason, CalculatedAt from RiskAssessment where OverallRisk in ('Warning','Critical') order by CalculatedAt desc limit 50"}]
    }
  ]
}
