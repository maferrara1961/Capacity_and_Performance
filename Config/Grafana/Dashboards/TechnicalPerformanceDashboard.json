    {
      "id": 7,
      "title": "Average Peak P95",
      "description": "Operational KPI table with average, peak, and P95 utilization.",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "CapacityPostgreSQL"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 19
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "select coalesce(mr.Name, k.ResourceId) as HostName, k.ResourceId, k.MetricName, k.AverageUtilization, k.PeakUtilization, k.P95Utilization from CapacityKpi k left join MonitoredResource mr on mr.ResourceId = k.ResourceId where k.CapacityKpiId ~ '^(${LoadId:regex})' and coalesce(mr.Name, k.ResourceId) ~ '^(${HostName:regex})' order by k.P95Utilization desc, k.CalculatedAt desc limit 50"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "title": "Ver graficos del equipo",
              "url": "/d/technical-performance/technical-performance-dashboard?var-LoadId=${LoadId}&var-HostName=${__data.fields.HostName}${__field.labels.host_name}&var-ServiceId=${__data.fields.ServiceId}${__data.fields.BusinessServiceId}",
              "targetBlank": false
            },
            {
              "title": "Ver subsistema o servicio",
              "url": "/d/technical-performance/technical-performance-dashboard?var-LoadId=${LoadId}&var-ServiceId=${__data.fields.ServiceId}${__data.fields.BusinessServiceId}&var-HostName=.*",
              "targetBlank": false
            }
          ]
        }
      }
    },
    {
      "id": 8,
      "title": "Top Consumers And Outliers",
      "description": "Highest consumers with ServiceId and ResourceId context for prioritizing operations work.",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "CapacityPostgreSQL"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 19
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "select m.ServiceId, coalesce(mr.Name, k.ResourceId) as HostName, k.ResourceId, k.MetricName, k.AverageUtilization, k.PeakUtilization, k.P95Utilization, k.HeadroomAvailable from CapacityKpi k left join ServiceResourceMap m on m.ResourceId = k.ResourceId left join MonitoredResource mr on mr.ResourceId = k.ResourceId where k.CapacityKpiId ~ '^(${LoadId:regex})' and coalesce(mr.Name, k.ResourceId) ~ '^(${HostName:regex})' and coalesce(m.ServiceId, '') ~ '^(${ServiceId:regex})' order by k.P95Utilization desc, k.PeakUtilization desc limit 20"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "title": "Ver graficos del equipo",
              "url": "/d/technical-performance/technical-performance-dashboard?var-LoadId=${LoadId}&var-HostName=${__data.fields.HostName}${__field.labels.host_name}&var-ServiceId=${__data.fields.ServiceId}${__data.fields.BusinessServiceId}",
              "targetBlank": false
            },
            {
              "title": "Ver subsistema o servicio",
              "url": "/d/technical-performance/technical-performance-dashboard?var-LoadId=${LoadId}&var-ServiceId=${__data.fields.ServiceId}${__data.fields.BusinessServiceId}&var-HostName=.*",
              "targetBlank": false
            }
          ]
        }
      }
    },
    {
      "id": 9,
      "title": "Threshold Breaches",
      "description": "Warning and Critical conditions with resource/service severity context.",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "CapacityPostgreSQL"
      },
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 26
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "select coalesce(mr.Name, r.ScopeId) as HostName, r.ScopeId as ResourceId, r.OverallRisk, r.Reason, r.CalculatedAt from RiskAssessment r left join MonitoredResource mr on mr.ResourceId = r.ScopeId where r.RiskAssessmentId ~ '^(${LoadId:regex})' and coalesce(mr.Name, r.ScopeId) ~ '^(${HostName:regex})' and r.OverallRisk in ('Warning','Critical') order by case r.OverallRisk when 'Critical' then 2 when 'Warning' then 1 else 0 end desc, r.CalculatedAt desc limit 50"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "title": "Ver graficos del equipo",
              "url": "/d/technical-performance/technical-performance-dashboard?var-LoadId=${LoadId}&var-HostName=${__data.fields.HostName}${__field.labels.host_name}&var-ServiceId=${__data.fields.ServiceId}${__data.fields.BusinessServiceId}",
              "targetBlank": false
            },
            {
              "title": "Ver subsistema o servicio",
              "url": "/d/technical-performance/technical-performance-dashboard?var-LoadId=${LoadId}&var-ServiceId=${__data.fields.ServiceId}${__data.fields.BusinessServiceId}&var-HostName=.*",
              "targetBlank": false
            }
          ]
        }
      }
    }
  ],
  "uid": "technical-performance"
