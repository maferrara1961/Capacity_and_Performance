FROM grafana/grafana-oss:latest
LABEL org.opencontainers.image.title="Capacity Grafana"
LABEL org.opencontainers.image.description="Self-hosted Grafana OSS dashboards for capacity observability"
COPY Config/Grafana/Datasources /etc/grafana/provisioning/datasources
COPY Config/Grafana/DashboardProviders /etc/grafana/provisioning/dashboards
COPY Config/Grafana/Dashboards /etc/grafana/dashboards
